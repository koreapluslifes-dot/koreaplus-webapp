# ══════════════════════════════════════════════════════════════════════════════
# KoreaPlus Webapp — Environment Variables
# Set ALL of these as Cloudflare Worker secrets via:
#   npx wrangler secret put SECRET_NAME
# DO NOT commit actual values to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Existing secrets (already deployed) ──────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...          # https://openrouter.ai/keys
GOOGLE_PLACES_KEY=AIzaSy...              # Google Cloud Console → Places API

# ── 한국 공공 API (data.go.kr 에서 무료 발급, 보통 당일 처리) ────────────────
# 한국관광공사 TourAPI 4.0 — https://apis.data.go.kr/B551011/EngService2
# 신청: https://www.data.go.kr/data/15101578/openapi.do
TOUR_API_KEY=your_encoded_service_key

# KOPIS 공연예술통합전산망 — https://www.kopis.or.kr/por/cs/openapi/openApiInfo.do
# 신청: https://www.kopis.or.kr/por/cs/openapi/openApiRegForm.do
KOPIS_API_KEY=your_kopis_key

# 기상청 동네예보 (단기/초단기) — https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# 신청: https://www.data.go.kr/data/15084084/openapi.do
KMA_API_KEY=your_encoded_service_key

# 한국환경공단 에어코리아 미세먼지 — https://apis.data.go.kr/B552584/ArpltnInforInqireSvc
# 신청: https://www.data.go.kr/data/15073861/openapi.do
AIRKOREA_API_KEY=your_encoded_service_key

# 서울 열린데이터광장 (지하철/버스/따릉이) — https://data.seoul.go.kr
# 신청: https://data.seoul.go.kr/dataPortal/member/member/join.do
SEOUL_OPEN_DATA_KEY=your_seoul_key

# ExchangeRate-API — https://www.exchangerate-api.com (1,500 req/month free)
# 신청: https://app.exchangerate-api.com/sign-up
EXCHANGE_RATE_KEY=your_exchange_key

# ── LLM (AI 동선 최적화용 — 추후 Phase 3) ────────────────────────────────────
# Groq API (Llama 3.3 70B — 14,400 req/day free) — https://console.groq.com
GROQ_API_KEY=gsk_...

# ── 클라이언트 측 (index.html window.* 변수로 주입, Worker secret 아님) ───────
# window.WORKER_URL = 'https://koreaplus-ai.YOUR_SUBDOMAIN.workers.dev'
# window.MAPS_KEY = 'AIzaSy...'  (Google Maps Embed API key)
